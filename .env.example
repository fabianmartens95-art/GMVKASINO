HOST=0.0.0.0
PORT=8787
# Optional non-Railway fallback for health revision metadata; use a hexadecimal Git SHA.
# Railway GitHub deploys provide RAILWAY_GIT_COMMIT_SHA automatically and it takes precedence.
APP_REVISION=
DEMO_STARTING_BALANCE=1000
DEMO_SESSION_IDLE_TTL_MS=86400000
DEMO_SESSION_ABSOLUTE_TTL_MS=604800000
AUTH_SESSION_IDLE_TTL_MS=86400000
AUTH_SESSION_ABSOLUTE_TTL_MS=604800000
AUTH_RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=10
DEMO_SESSION_STORE_PATH=.data/demo-sessions.json
DATABASE_URL=
DATABASE_SSL=false
DATABASE_SSL_CA=
# Optional: when set (24+ chars), enables GET /api/v1/internal/metrics with Bearer auth.
METRICS_TOKEN=
SPIN_RATE_LIMIT_WINDOW_MS=10000
SPIN_RATE_LIMIT_MAX=15
MAX_JSON_BODY_BYTES=16384
AUDIT_MAX_EVENTS=1000
